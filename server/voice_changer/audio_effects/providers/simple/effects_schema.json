{
  "gain": {
    "name": "Simple Gain",
    "description": "Basic volume adjustment",
    "provider": "Simple",
    "parameters": {
      "gain": {
        "name": "Gain",
        "type": "slider",
        "defaultValue": 0,
        "min": -20,
        "max": 20,
        "step": 0.1,
        "unit": "dB",
        "description": "Amount of volume boost or cut"
      }
    }
  },
  "lowpass": {
    "name": "Simple Low Pass",
    "description": "Basic IIR low-pass filter",
    "provider": "Simple",
    "parameters": {
      "cutoff": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 1000,
        "min": 20,
        "max": 20000,
        "step": 10,
        "unit": "Hz",
        "description": "Frequency above which signals are filtered out"
      }
    }
  },
  "highpass": {
    "name": "Simple High Pass",
    "description": "Basic IIR high-pass filter",
    "provider": "Simple",
    "parameters": {
      "cutoff": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 100,
        "min": 20,
        "max": 20000,
        "step": 10,
        "unit": "Hz",
        "description": "Frequency below which signals are filtered out"
      }
    }
  },
  "delay": {
    "name": "Simple Delay",
    "description": "Basic delay effect",
    "provider": "Simple",
    "parameters": {
      "delayTime": {
        "name": "Delay Time",
        "type": "slider",
        "defaultValue": 300,
        "min": 1,
        "max": 2000,
        "step": 1,
        "unit": "ms",
        "description": "Time delay for echoes"
      },
      "feedback": {
        "name": "Feedback",
        "type": "slider",
        "defaultValue": 0.3,
        "min": 0,
        "max": 0.9,
        "step": 0.01,
        "description": "Amount of feedback for multiple echoes"
      },
      "wetLevel": {
        "name": "Wet Level",
        "type": "slider",
        "defaultValue": 0.3,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "Level of delayed signal"
      }
    }
  }
}