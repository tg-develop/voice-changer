  },
  "lowShelfFilter": {
    "name": "Low Shelf Filter",
    "description": "Boosts/cuts low frequencies",
    "provider": "Pedalboard",
    "parameters": {
      "cutoff": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 200,
        "min": 20,
        "max": 2000,
        "step": 10,
        "unit": "Hz",
        "description": "Frequency where shelf begins"
      },
      "gain": {
        "name": "Gain",
        "type": "slider",
        "defaultValue": 0,
        "min": -12,
        "max": 12,
        "step": 0.1,
        "unit": "dB",
        "description": "Amount of boost or cut"
      },
      "q": {
        "name": "Q Factor",
        "type": "slider",
        "defaultValue": 0.7,
        "min": 0.1,
        "max": 10,
        "step": 0.1,
        "description": "Sharpness of the transition"
      }
    }
  },
  "convolution": {
    "name": "Convolution",
    "description": "Impulse response reverb/simulation",
    "provider": "Pedalboard",
    "parameters": {
      "impulseResponse": {
        "name": "Impulse Response",
        "type": "select",
        "defaultValue": "hall",
        "options": ["hall", "room", "plate", "spring", "cathedral"],
        "description": "Type of acoustic space to simulate"
      },
      "mix": {
        "name": "Mix",
        "type": "slider",
        "defaultValue": 0.3,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "Balance between dry and processed signal"
      }
    }
  },
  "mp3Compressor": {
    "name": "MP3 Compressor",
    "description": "Adds MP3 compression artifacts",
    "provider": "Pedalboard",
    "parameters": {
      "vbrQuality": {
        "name": "VBR Quality",
        "type": "slider",
        "defaultValue": 2,
        "min": 0,
        "max": 9,
        "step": 1,
        "description": "MP3 VBR quality (0=highest, 9=lowest)"
      }
    }
  },
  "gsmCompressor": {
    "name": "GSM Compressor",
    "description": "2G cellular phone compression",
    "provider": "Pedalboard",
    "parameters": {}
